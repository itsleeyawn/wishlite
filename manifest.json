{
  "manifest_version": 3,
  "name": "Wishlite",
  "version": "0.1.0",
  "description": "Save the current page to a categorized wishlist.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wishlite"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wishlite@leonletournel.dev"
    }
  }
}
